BoxLayout:
    orientation: "vertical"

    BoxLayout:
        size_hint_y: None
        height: 50
        spacing: 5
        padding: 5

        Button:
            id: back_btn_layout
            on_release: app.on_exit_btn()
            text: "exit"

        Button:
            text: "Home"
            on_release:
                screen_manager.transition.direction = 'right'
                screen_manager.current = "home"
        Button:
            text: "Filter"
            on_release:
                screen_manager.transition.direction = 'left'
                screen_manager.current = "filter"

    # ScreenManager
    ScreenManager:
        id: screen_manager

        HomeScreen:
            name: "home"
        FilterScreen:
            name: "filter"

